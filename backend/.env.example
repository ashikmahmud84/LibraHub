# Local backend settings. Render supplies PORT automatically.
PORT=3000
NODE_ENV=development

# Exact frontend origins, comma-separated. Set the Vercel origin(s) in Render.
CORS_ORIGINS=http://localhost:5173

# Connect to the existing LibraHub Atlas database. Replace placeholders locally;
# never commit a real connection string.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/LibraHub?retryWrites=true&w=majority
MONGODB_DB=LibraHub

# Firebase Admin SDK must use the existing Firebase project.
FIREBASE_PROJECT_ID=<existing-firebase-project-id>
# Provide the service-account JSON as a protected environment variable, or use
# Application Default Credentials locally (GOOGLE_APPLICATION_CREDENTIALS).
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
# Optional status-endpoint display value; not needed for Firebase token verification.
FIREBASE_STORAGE_BUCKET=

# Replace with the exact existing administrator email allowlist; do not broaden it.
ADMIN_EMAILS=<existing-approved-admin-email>

# Cloudinary credentials belong only in the backend environment.
CLOUDINARY_CLOUD_NAME=<cloudinary-cloud-name>
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<cloudinary-api-secret>
